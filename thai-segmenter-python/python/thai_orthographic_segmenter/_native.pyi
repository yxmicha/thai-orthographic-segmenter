"""Type stubs for the compiled half of `thai_orthographic_segmenter`."""

from os import PathLike

class SegmenterError(ValueError):
    """A segmenter could not load its model or segment the text."""

class SyllableTokenizer:
    def __init__(self) -> None: ...
    def tokenize(self, text: str) -> list[str]: ...
    def spans(self, text: str) -> list[tuple[int, int]]: ...

class WordTokenizer:
    def __init__(self) -> None: ...
    @staticmethod
    def with_dictionary(words: list[str]) -> WordTokenizer: ...
    @staticmethod
    def load(directory: str | PathLike[str]) -> WordTokenizer: ...
    def tokenize(self, text: str) -> list[str]: ...
    def spans(self, text: str) -> list[tuple[int, int]]: ...
    def tokenize_many(self, texts: list[str], jobs: int | None = None) -> list[list[str]]: ...

class LineBreaker:
    def __init__(self, icu_dictionary: str | None = None) -> None: ...
    def mark(self, text: str) -> str: ...

def orthographic_parts(text: str) -> list[tuple[str, str, int, int]]: ...
